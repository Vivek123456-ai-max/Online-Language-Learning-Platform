<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>CodeVerse Online Learning Platform - Java Backend</display-name>
    <description>
        Enterprise Java Web Application powered by Java Servlets, JDBC, and PostgreSQL.
        Supports multi-role authentication, course catalog management, and student enrollments.
    </description>

    <!-- Global CORS Filter -->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>com.codeverse.filter.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 1. Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.codeverse.servlet.AuthServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <!-- 2. Course Management Servlet -->
    <servlet>
        <servlet-name>CourseServlet</servlet-name>
        <servlet-class>com.codeverse.servlet.CourseServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseServlet</servlet-name>
        <url-pattern>/api/courses/*</url-pattern>
    </servlet-mapping>

    <!-- 3. Enrollment & Progress Servlet -->
    <servlet>
        <servlet-name>EnrollmentServlet</servlet-name>
        <servlet-class>com.codeverse.servlet.EnrollmentServlet</servlet-class>
        <load-on-startup>3</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>EnrollmentServlet</servlet-name>
        <url-pattern>/api/enrollments/*</url-pattern>
    </servlet-mapping>

    <!-- 4. Health Check & Diagnostics Servlet -->
    <servlet>
        <servlet-name>HealthCheckServlet</servlet-name>
        <servlet-class>com.codeverse.servlet.HealthCheckServlet</servlet-class>
        <load-on-startup>4</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthCheckServlet</servlet-name>
        <url-pattern>/api/health</url-pattern>
    </servlet-mapping>

    <!-- Session Timeout Configuration (60 minutes) -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
